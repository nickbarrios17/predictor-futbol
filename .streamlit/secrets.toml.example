# Plantilla de secrets para Streamlit Community Cloud.
#
# En local: copia este archivo a .streamlit/secrets.toml y completa los
# valores (ese archivo SI esta en .gitignore, nunca se sube).
#
# En Streamlit Cloud: pega este mismo contenido, ya completado, en
# "Manage app" -> "Settings" -> "Secrets" del dashboard. Las claves de
# nivel raiz quedan disponibles como variables de entorno normales
# (os.getenv), asi que el resto del codigo no necesita cambios.

RAPIDAPI_KEY = "tu_clave_de_rapidapi"
GEMINI_API_KEY = "tu_clave_de_gemini"

# Fuente primaria de datos (ver sources/football_data.py). RapidAPI/SofaScore
# de arriba queda como fallback automatico si se agota la cuota diaria.
API_FOOTBALL_KEY = "tu_clave_de_api-sports.io"

# Opcional: solo hace falta si migraste el historial a Turso para que
# no se borre en cada reinicio del hosting (ver database/sqlite.py).
# Si se dejan vacias/ausentes, la app usa SQLite local como siempre.
TURSO_DATABASE_URL = "libsql://tu-base.turso.io"
TURSO_AUTH_TOKEN = "tu_token_de_turso"

# Opcional: solo hace falta si usas la sincronizacion con Google Sheets.
# Pega aca el contenido COMPLETO del credentials.json del service
# account (todo en una sola linea, como string), en vez de subir el
# archivo. Ver database/sheets.py.
GOOGLE_CREDENTIALS_JSON = '{"type": "service_account", "project_id": "...", "...": "..."}'
